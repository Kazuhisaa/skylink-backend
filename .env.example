# Database
DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost/skylink_dev
TEST_DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost/skylink_test

# Supabase (if used instead of / alongside direct Postgres)
SUPABASE_URL=
SUPABASE_KEY=

# Application
DEBUG=              # Bool, eg True during dev
JWT_SECRET_KEY=      # required - generate random string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Mail (used for OTP verification, password reset)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@skylink.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Skylink
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
VALIDATE_CERTS=True

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PayMongo
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=